# Live presence/follow feature (see src/components/presence/) — browser-only Supabase
# Realtime, no database, no auth. If either var is unset the feature silently disables itself.
#
# Create a free project at supabase.com, then Project Settings > API for these two values.
# Only the publishable key belongs here — never the project's secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
